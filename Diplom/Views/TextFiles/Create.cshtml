@model Diplom.Models.TextFile

<link rel="stylesheet" href="~/css/site.css" />

<div class="container">
    <h1>Загрузить текстовый файл</h1>

    <form asp-action="Create" enctype="multipart/form-data" method="post">
        <div class="form-group">
            <label>Выберите файл (.txt, .docx, .pdf)</label>
            <div>
                <label for="uploadedFile" class="btn btn-secondary" style="cursor: pointer;">Выбрать файл</label>
                <input type="file" name="uploadedFile" id="uploadedFile" accept=".txt,.docx,.pdf" style="display: none;" />
                <span id="fileNameDisplay" class="file-name-display" style="margin-left: 10px;">Файл не выбран</span>
            </div>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <button type="submit" class="btn btn-success">Загрузить</button>
            <a asp-action="Index" asp-controller="TextFiles" class="btn btn-secondary">Отмена</a>
            <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">На главную</a>
        </div>
    </form>
</div>

<script>
    document.getElementById('uploadedFile').addEventListener('change', function(e) {
        var fileName = e.target.files[0] ? e.target.files[0].name : 'Файл не выбран';
        document.getElementById('fileNameDisplay').textContent = fileName;
    });
</script>