@model IEnumerable<Diplom.Models.TextFile>

<link rel="stylesheet" href="~/css/site.css" />

@{
    ViewData["Title"] = "Текстовые файлы";
}

<div class="container">
    <h1>Загруженные текстовые файлы</h1>
    <p>
        <a asp-action="Create" class="btn btn-primary">Загрузить новый файл</a>
    </p>

    <div class="filter-container" style="margin-bottom: 20px;">
        <label for="fileSearch">Фильтр по имени файла:</label>
        <input type="text" id="fileSearch" class="filter-input" placeholder="Введите часть имени..." style="width: 300px; margin-left: 10px;" />
    </div>

    <table class="table table-striped" id="filesTable">
        <thead>
            <tr>
                <th>Имя файла</th>
                <th>Дата загрузки</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="file-row">
                    <td class="file-name">@Html.DisplayFor(m => item.FileName)</td>
                    <td>@Html.DisplayFor(m => item.UploadedAt)</td>
                    <td class="actions">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Просмотр</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    document.getElementById('fileSearch').addEventListener('input', function() {
        var filter = this.value.toLowerCase();
        var rows = document.querySelectorAll('#filesTable tbody .file-row');
        rows.forEach(function(row) {
            var fileNameCell = row.querySelector('.file-name');
            if (fileNameCell) {
                var text = fileNameCell.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            }
        });
    });
</script>